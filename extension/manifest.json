{
  "manifest_version": 3,
  "name": "D2 Survivors 繁體中文",
  "version": "0.1.0",
  "description": "把 d2survivors.lol 的遊戲翻成繁體中文（非官方）",
  "permissions": ["declarativeNetRequest", "webRequest", "storage"],
  "host_permissions": ["https://d2survivors.lol/*"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "zh", "enabled": true, "path": "rules.json" }]
  },
  "web_accessible_resources": [
    { "resources": ["zh-TW.js"], "matches": ["https://d2survivors.lol/*"] }
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://d2survivors.lol/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://d2survivors.lol/*"],
      "js": ["site-dict.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "D2 Survivors 繁中" }
}
